# docker-compose.prod.yml 전용. 배포 전에 .env로 복사해서 전부 실제 값으로 바꿀 것
# (.env는 git에 안 올라감 — 루트 .gitignore가 이미 무시하지는 않으니 새로 커밋되지 않게 주의).

MYSQL_ROOT_PASSWORD=change-me
DB_NAME=kanban
DB_USERNAME=kanban
DB_PASSWORD=change-me

JWT_SECRET=change-me-to-a-random-32byte-plus-secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=1209600000

# 프론트 빌드 시 결과물에 박히는 백엔드 주소 (배포 도메인으로 교체)
VITE_API_BASE_URL=http://localhost:8080

# 백엔드가 허용할 프론트 origin (콤마로 여러 개 가능, 배포 도메인으로 교체)
CORS_ALLOWED_ORIGINS=http://localhost

# 소셜 로그인 성공/실패 후 리다이렉트할 프론트 주소 (배포 도메인으로 교체)
FRONTEND_BASE_URL=http://localhost

# refresh token 쿠키의 Secure 속성. HTTPS로 배포했으면 true로 바꿀 것 (http면 브라우저가 쿠키를 버림).
COOKIE_SECURE=false

# 구글 OAuth — https://console.cloud.google.com/apis/credentials 에서 발급
# 승인된 리디렉션 URI: {백엔드주소}/login/oauth2/code/google
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# 네이버 OAuth — https://developers.naver.com/apps 에서 발급
# 콜백 URL: {백엔드주소}/login/oauth2/code/naver
NAVER_CLIENT_ID=change-me
NAVER_CLIENT_SECRET=change-me
